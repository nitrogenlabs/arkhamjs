{
  "author": {
    "email": "giraldo@nitrogenlabs.com",
    "name": "Giraldo Rosales",
    "url": "http://nitrogenlabs.com"
  },
  "browser": "./index.js",
  "bugs": {
    "url": "https://github.com/nitrogenlabs/arkhamjs/issues"
  },
  "dependencies": {
    "@nlabs/utils": "2.10.7",
    "events": "^3.3.0"
  },
  "description": "Universal TypeScript state management with predictable Flux data flow, immutable updates, events, middleware, and persistent storage.",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./index.js",
      "require": "./index.js"
    },
    "./constants": {
      "types": "./lib/constants/ArkhamConstants.d.ts",
      "import": "./lib/constants/ArkhamConstants.js",
      "require": "./lib/constants/ArkhamConstants.js"
    },
    "./Flux": {
      "types": "./lib/Flux/Flux.d.ts",
      "import": "./lib/Flux/Flux.js",
      "require": "./lib/Flux/Flux.js"
    },
    "./Flux/types": {
      "types": "./lib/Flux/Flux.types.d.ts",
      "import": "./lib/Flux/Flux.types.js",
      "require": "./lib/Flux/Flux.types.js"
    }
  },
  "files": [
    "index.d.ts",
    "index.js",
    "lib",
    "LICENSE",
    "package.json",
    "README.md"
  ],
  "gitHead": "fc371e1e28fe0ae35d40d29a217d5f0e990ec32a",
  "homepage": "https://arkhamjs.nitrogenx.co",
  "keywords": [
    "arkhamjs",
    "event-driven",
    "flux",
    "global-state",
    "immutable",
    "middleware",
    "nodejs",
    "nitrogenlabs",
    "persistence",
    "react",
    "react-native",
    "state",
    "state-management",
    "typescript",
    "universal"
  ],
  "license": "MIT",
  "main": "./index.js",
  "module": "./index.js",
  "name": "@nlabs/arkhamjs",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitrogenlabs/arkhamjs.git"
  },
  "scripts": {
    "build": "lex compile --remove",
    "clean": "lex clean",
    "lint": "(lex lint --fix) || true",
    "prepublishOnly": "npm run build",
    "pretest": "npm run lint",
    "publish:major": "npm version major && npm publish",
    "publish:minor": "npm version minor && npm publish",
    "publish:patch": "npm version patch && npm publish",
    "test": "lex test",
    "update": "lex update --interactive"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./lib/index.d.ts",
  "version": "3.31.14"
}
