{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "composite": false,
    "sourceMap": false,
    "inlineSourceMap": false,
    "outDir": "lib"
  },
  "include": [
    "./src/**/*.ts",
    "./src/**/*.tsx"
  ],
  "exclude": [
    "lib",
    "./node_modules",
    "./src/**/*.test.ts",
    "./src/**/*.test.tsx",
    "**/*.js"
  ]
}
